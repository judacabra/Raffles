{
  "name": "raffles-backend",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "prepare": "husky",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest --selectProjects unit",
    "test:all": "jest",
    "test:cov": "jest --selectProjects unit integration --coverage",
    "test:e2e": "jest --selectProjects e2e",
    "test:integration": "jest --selectProjects integration",
    "test:unit": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch"
  },
  "dependencies": {
    "@fastify/etag": "6.0.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "8.1.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-fastify": "11.1.19",
    "@nestjs/swagger": "11.4.2",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.0",
    "@nestjs/typeorm": "12.0.1",
    "@webundsoehne/nest-fastify-file-upload": "2.3.1",
    "bcryptjs": "3.0.3",
    "chokidar": "5.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.8.4",
    "multer": "2.4.0",
    "nestjs-pino": "4.2.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "pino": "9.6.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.19",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.19",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.24",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.12.2",
    "@types/supertest": "7.2.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "lint-staged": "16.4.0",
    "nx": "22.7.1",
    "pino-pretty": "13.0.0",
    "prettier": "3.8.2",
    "supertest": "7.2.2",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  }
}
